{% extends 'base.html.twig' %}

{% block body %}
    <main>
        <h1>Connexion adhérent</h1>

        {% if echec %}
            <p role="alert">Identifiants invalides.</p>
        {% endif %}

        <form method="post" action="{{ path('app_connexion') }}">
            <label for="email">Adresse électronique</label>
            <input type="email" id="email" name="_username" value="{{ email }}" autocomplete="username" required>

            <label for="mot-de-passe">Mot de passe</label>
            <input type="password" id="mot-de-passe" name="_password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit">Se connecter</button>
        </form>
    </main>
{% endblock %}
